---
permalink: "/contact.html"
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Contact | Srijayee</title>
<meta name="description" content="Get in touch for content strategy, brand partnerships, or personal styling sessions.">
<meta property="og:title" content="Contact | Srijayee">
<meta property="og:description" content="Get in touch for content strategy, brand partnerships, or personal styling sessions.">
<meta property="og:type" content="website">
<meta name="twitter:card" content="summary_large_image">
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet">
<style>
  body{font-family:'Inter',sans-serif;background-color:#000;color:#fff;overflow-x:hidden;}
  .serif{font-family:'Playfair Display',serif;}
  a:focus-visible,button:focus-visible,input:focus-visible,textarea:focus-visible{outline:2px solid #fff;outline-offset:3px;}
  input,textarea{background:transparent;}
  input:focus,textarea:focus{outline:none;border-bottom-color:#fff;}
  summary::-webkit-details-marker{display:none;}
  summary::after{content:"+";color:#9ca3af;}
  details[open] summary::after{content:"–";}
  .inquiry-btn.is-active{background:#fff;color:#000;}
  .inquiry-btn{background:#000;color:#9ca3af;}
</style>
</head>
<body class="antialiased selection:bg-gray-700 selection:text-white">

{% set active = "contact" %}
{% include "nav.njk" %}

<header class="max-w-screen-lg mx-auto px-8 pt-12 pb-4 max-w-2xl">
  <p class="text-xs uppercase tracking-[0.2em] text-gray-500 mb-6">{{ contact.eyebrow }}</p>
  <h1 class="text-4xl md:text-6xl serif font-medium leading-tight text-gray-200">{{ contact.heading }}</h1>
  <p class="text-gray-400 font-light text-base md:text-lg mt-6 leading-relaxed max-w-xl">{{ contact.subtext }}</p>
</header>

<section class="max-w-screen-lg mx-auto px-8 py-12">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-gray-900 border border-gray-900 mb-14" id="inquiryTypes">
    {% for t in contact.inquiry_types %}
    <button type="button" data-type="{{ t }}" class="inquiry-btn {{ 'is-active' if loop.first }} py-5 px-4 text-xs uppercase tracking-widest transition hover:bg-white hover:text-black">{{ t }}</button>
    {% endfor %}
  </div>

  <!--
    NOTE for setup: this form currently just opens an email draft (mailto).
    If you'd rather it submit directly on the page without opening an email app,
    a free form service like Formspree or Web3Forms can be swapped in later.
  -->
  <form id="contactForm" class="flex flex-col gap-8 max-w-xl">
    <div>
      <label class="block text-xs uppercase tracking-widest text-gray-500 mb-2">Name</label>
      <input type="text" id="name" required class="w-full border-0 border-b border-gray-700 py-2 text-white text-base">
    </div>
    <div>
      <label class="block text-xs uppercase tracking-widest text-gray-500 mb-2">Email</label>
      <input type="email" id="email" required class="w-full border-0 border-b border-gray-700 py-2 text-white text-base">
    </div>
    <div>
      <label class="block text-xs uppercase tracking-widest text-gray-500 mb-2">Message</label>
      <textarea id="message" required class="w-full border-0 border-b border-gray-700 py-2 text-white text-base min-h-[120px] resize-y"></textarea>
    </div>
    <button type="submit" class="self-start bg-white text-black px-10 py-4 text-xs uppercase tracking-widest hover:bg-gray-300 transition">Send Message</button>
    <p class="text-xs text-gray-500">{{ contact.form_note }}</p>
  </form>

  <div class="flex gap-6 py-8 mt-10 border-t border-gray-900 text-xs uppercase tracking-widest text-gray-400">
    <a href="{{ social.pinterest_url }}" target="_blank" rel="noopener" class="hover:text-white transition">Pinterest</a>
    <a href="{{ social.instagram_url }}" target="_blank" rel="noopener" class="hover:text-white transition">Instagram</a>
    <a href="{{ social.facebook_url }}" target="_blank" rel="noopener" class="hover:text-white transition">Facebook</a>
  </div>
</section>

<section class="max-w-screen-lg mx-auto px-8 py-16 border-t border-gray-900">
  <p class="text-xs uppercase tracking-[0.2em] text-gray-500 mb-2">{{ contact.faq_eyebrow }}</p>
  <h2 class="text-3xl serif text-gray-200 mb-8">{{ contact.faq_heading }}</h2>
  {% for f in contact.faq %}
  <details {{ 'open' if loop.first }} class="border-b border-gray-900 py-5">
    <summary class="cursor-pointer flex justify-between items-center serif text-lg text-gray-200">{{ f.question }}</summary>
    <p class="mt-3 text-gray-500 font-light text-sm max-w-xl leading-relaxed">{{ f.answer }}</p>
  </details>
  {% endfor %}
</section>

{% include "footer.njk" %}

<script>
let selectedType = {{ (contact.inquiry_types[0] or "Writing / Content") | dump | safe }};
const contactEmail = {{ (social.contact_email or "ivygstyles@gmail.com") | dump | safe }};

document.getElementById('inquiryTypes').addEventListener('click', e => {
  if (e.target.tagName !== 'BUTTON') return;
  document.querySelectorAll('#inquiryTypes button').forEach(b => b.classList.remove('is-active'));
  e.target.classList.add('is-active');
  selectedType = e.target.dataset.type;
});

document.getElementById('contactForm').addEventListener('submit', function(e){
  e.preventDefault();
  const name = document.getElementById('name').value;
  const email = document.getElementById('email').value;
  const message = document.getElementById('message').value;
  const subject = encodeURIComponent(`${selectedType} inquiry — from ${name}`);
  const body = encodeURIComponent(`${message}\n\n— ${name} (${email})`);
  window.location.href = `mailto:${contactEmail}?subject=${subject}&body=${body}`;
});
</script>
{% include "analytics.njk" %}
</body>
</html>

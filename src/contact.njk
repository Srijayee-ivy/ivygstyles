---
permalink: "/contact.html"
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Contact | Srijayee</title>
<meta name="description" content="Get in touch for content strategy, brand partnerships, or personal styling sessions.">
<meta property="og:title" content="Contact | Srijayee">
<meta property="og:description" content="Get in touch for content strategy, brand partnerships, or personal styling sessions.">
<meta property="og:type" content="website">
<meta name="twitter:card" content="summary_large_image">
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#000000; --paper-deep:#14110B;
    --ink:#D4AF37; --ink-soft:#A08847;
    --muted:#D6CBB0; --faint:#5C4F2E;
    --line:#2A2419; --brass:#F0C550;
  }

  body{font-family:'Inter',sans-serif;background-color:var(--paper);color:var(--ink);overflow-x:hidden;}
  .serif{font-family:'Playfair Display',serif;}
  a:focus-visible,button:focus-visible,input:focus-visible,textarea:focus-visible{outline:2px solid var(--ink);outline-offset:3px;}
  input,textarea{background:transparent;}
  input:focus,textarea:focus{outline:none;border-bottom-color:var(--ink);}
  summary::-webkit-details-marker{display:none;}
  summary::after{content:"+";color:var(--muted);}
  details[open] summary::after{content:"–";}
  .inquiry-btn.is-active{background:var(--ink);color:var(--paper);}
  .inquiry-btn{background:var(--paper);color:var(--muted);}
</style>
</head>
<body class="antialiased selection:bg-[var(--line)] selection:text-[var(--ink)]">

{% set active = "contact" %}
{% include "nav.njk" %}

<header class="max-w-screen-lg mx-auto px-8 pt-12 pb-4 max-w-2xl">
  <p class="text-xs uppercase tracking-[0.2em] text-[var(--muted)] mb-6">{{ contact.eyebrow }}</p>
  <h1 data-hero-reveal class="text-4xl md:text-6xl serif font-medium leading-tight text-[var(--ink)]">{{ contact.heading }}</h1>
  <p class="text-[var(--ink-soft)] font-light text-base md:text-lg mt-6 leading-relaxed max-w-xl">{{ contact.subtext }}</p>
</header>

<section class="max-w-screen-lg mx-auto px-8 py-12">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-[var(--paper-deep)] border border-[var(--line)] mb-14" id="inquiryTypes">
    {% for t in contact.inquiry_types %}
    <button type="button" data-type="{{ t }}" class="inquiry-btn {{ 'is-active' if loop.first }} py-5 px-4 text-xs uppercase tracking-widest transition hover:bg-[var(--ink)] hover:text-[var(--paper)]">{{ t }}</button>
    {% endfor %}
  </div>

  <!--
    NOTE for setup: this form currently just opens an email draft (mailto).
    If you'd rather it submit directly on the page without opening an email app,
    a free form service like Formspree or Web3Forms can be swapped in later.
  -->
  <form id="contactForm" class="flex flex-col gap-8 max-w-xl">
    <div>
      <label class="block text-xs uppercase tracking-widest text-[var(--muted)] mb-2">Name</label>
      <input type="text" id="name" required class="w-full border-0 border-b border-[var(--line)] py-2 text-[var(--ink)] text-base">
    </div>
    <div>
      <label class="block text-xs uppercase tracking-widest text-[var(--muted)] mb-2">Email</label>
      <input type="email" id="email" required class="w-full border-0 border-b border-[var(--line)] py-2 text-[var(--ink)] text-base">
    </div>
    <div>
      <label class="block text-xs uppercase tracking-widest text-[var(--muted)] mb-2">Message</label>
      <textarea id="message" required class="w-full border-0 border-b border-[var(--line)] py-2 text-[var(--ink)] text-base min-h-[120px] resize-y"></textarea>
    </div>
    <button type="submit" data-magnetic class="self-start bg-[var(--ink)] text-[var(--paper)] px-10 py-4 text-xs uppercase tracking-widest hover:bg-[var(--ink-soft)] transition">Send Message</button>
    <p class="text-xs text-[var(--muted)]">{{ contact.form_note }}</p>
  </form>

  <div class="flex gap-6 py-8 mt-10 border-t border-[var(--line)] text-xs uppercase tracking-widest text-[var(--ink-soft)]">
    <a href="{{ social.pinterest_url }}" target="_blank" rel="noopener" class="hover:text-[var(--brass)] transition">Pinterest</a>
    <a href="{{ social.instagram_url }}" target="_blank" rel="noopener" class="hover:text-[var(--brass)] transition">Instagram</a>
    <a href="{{ social.facebook_url }}" target="_blank" rel="noopener" class="hover:text-[var(--brass)] transition">Facebook</a>
  </div>
</section>

<section class="max-w-screen-lg mx-auto px-8 py-16 border-t border-[var(--line)]">
  <p class="text-xs uppercase tracking-[0.2em] text-[var(--muted)] mb-2">{{ contact.faq_eyebrow }}</p>
  <h2 class="text-3xl serif text-[var(--ink)] mb-8">{{ contact.faq_heading }}</h2>
  {% for f in contact.faq %}
  <details data-reveal {{ 'open' if loop.first }} class="border-b border-[var(--line)] py-5">
    <summary class="cursor-pointer flex justify-between items-center serif text-lg text-[var(--ink)]">{{ f.question }}</summary>
    <p class="mt-3 text-[var(--muted)] font-light text-sm max-w-xl leading-relaxed">{{ f.answer }}</p>
  </details>
  {% endfor %}
</section>

{% include "footer.njk" %}

<script>
let selectedType = {{ (contact.inquiry_types[0] or "Writing / Content") | dump | safe }};
const contactEmail = {{ (social.contact_email or "ivygstyles@gmail.com") | dump | safe }};

document.getElementById('inquiryTypes').addEventListener('click', e => {
  if (e.target.tagName !== 'BUTTON') return;
  document.querySelectorAll('#inquiryTypes button').forEach(b => b.classList.remove('is-active'));
  e.target.classList.add('is-active');
  selectedType = e.target.dataset.type;
});

document.getElementById('contactForm').addEventListener('submit', function(e){
  e.preventDefault();
  const name = document.getElementById('name').value;
  const email = document.getElementById('email').value;
  const message = document.getElementById('message').value;
  const subject = encodeURIComponent(`${selectedType} inquiry — from ${name}`);
  const body = encodeURIComponent(`${message}\n\n— ${name} (${email})`);
  window.location.href = `mailto:${contactEmail}?subject=${subject}&body=${body}`;
});
</script>
{% include "animations.njk" %}
{% include "analytics.njk" %}
</body>
</html>

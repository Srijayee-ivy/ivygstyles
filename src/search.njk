---
permalink: "/search.html"
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Search | Srijayee</title>
<meta name="description" content="Search articles, case studies, trend reports, and writing samples on The Ivygstyles Edit.">
<meta property="og:title" content="Search | Srijayee">
<meta property="og:description" content="Search articles, case studies, trend reports, and writing samples on The Ivygstyles Edit.">
<meta property="og:type" content="website">
<meta name="twitter:card" content="summary_large_image">
<link rel="canonical" href="https://ivygstyles.pages.dev{{ page.url }}">
<meta name="robots" content="noindex">
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#000000; --paper-deep:#14110B;
    --ink:#D4AF37; --ink-soft:#A08847;
    --muted:#D6CBB0; --faint:#5C4F2E;
    --line:#2A2419; --brass:#F0C550;
  }

  body{font-family:'Inter',sans-serif;background-color:var(--paper);color:var(--ink);overflow-x:hidden;}
  .serif{font-family:'Playfair Display',serif;}
  a:focus-visible,input:focus-visible{outline:2px solid var(--ink);outline-offset:3px;}
  #searchInput{background:transparent;}
  #searchInput:focus{outline:none;}
</style>
</head>
<body class="antialiased selection:bg-[var(--line)] selection:text-[var(--ink)]">

{% set active = "search" %}
{% include "nav.njk" %}

<header class="max-w-screen-md mx-auto px-8 pt-12 pb-8">
  <p class="text-xs uppercase tracking-[0.2em] text-[var(--muted)] mb-6">Search</p>
  <input
    type="text"
    id="searchInput"
    autofocus
    placeholder="Search articles, case studies, and pages…"
    class="w-full border-0 border-b border-[var(--line)] py-4 text-2xl md:text-4xl serif text-[var(--ink)] placeholder-[var(--faint)]"
  >
</header>

<section class="max-w-screen-md mx-auto px-8 pb-24">
  <p id="resultCount" class="text-xs uppercase tracking-widest text-[var(--muted)] mb-8"></p>
  <div id="results" class="space-y-8"></div>
</section>

{% include "footer.njk" %}
{% include "animations.njk" %}
{% include "analytics.njk" %}

<script>
(function(){
  let index = [];
  const input = document.getElementById('searchInput');
  const results = document.getElementById('results');
  const count = document.getElementById('resultCount');

  fetch('/search-index.json')
    .then(r => r.json())
    .then(data => { index = data; renderResults(''); })
    .catch(() => { count.textContent = "Couldn't load the search index."; });

  function renderResults(query) {
    const q = query.trim().toLowerCase();
    if (!q) {
      results.innerHTML = '';
      count.textContent = 'Start typing to search.';
      return;
    }
    const matches = index.filter(item =>
      (item.title || '').toLowerCase().includes(q) ||
      (item.excerpt || '').toLowerCase().includes(q) ||
      (item.category || '').toLowerCase().includes(q)
    );
    count.textContent = matches.length + (matches.length === 1 ? ' result' : ' results');
    results.innerHTML = matches.map(item => `
      <a href="${item.url}" class="group block border-b border-[var(--line)] pb-8">
        <span class="text-xs uppercase tracking-widest text-[var(--muted)]">${item.category}</span>
        <h2 class="text-2xl serif text-[var(--ink)] group-hover:text-[var(--brass)] group-hover:italic transition-all duration-300 mt-2 mb-2">${item.title}</h2>
        <p class="text-sm text-[var(--muted)] font-light">${item.excerpt}</p>
      </a>
    `).join('');
  }

  input.addEventListener('input', e => renderResults(e.target.value));
})();
</script>
</body>
</html>

---
permalink: "/search.html"
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Search | Srijayee</title>
<meta name="robots" content="noindex">
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet">
<style>
  body{font-family:'Inter',sans-serif;background-color:#000;color:#fff;overflow-x:hidden;}
  .serif{font-family:'Playfair Display',serif;}
  a:focus-visible,input:focus-visible{outline:2px solid #fff;outline-offset:3px;}
  #searchInput{background:transparent;}
  #searchInput:focus{outline:none;}
</style>
</head>
<body class="antialiased selection:bg-gray-700 selection:text-white">

{% set active = "search" %}
{% include "nav.njk" %}

<header class="max-w-screen-md mx-auto px-8 pt-12 pb-8">
  <p class="text-xs uppercase tracking-[0.2em] text-gray-500 mb-6">Search</p>
  <input
    type="text"
    id="searchInput"
    autofocus
    placeholder="Search articles, case studies, and pages…"
    class="w-full border-0 border-b border-gray-700 py-4 text-2xl md:text-4xl serif text-gray-200 placeholder-gray-700"
  >
</header>

<section class="max-w-screen-md mx-auto px-8 pb-24">
  <p id="resultCount" class="text-xs uppercase tracking-widest text-gray-600 mb-8"></p>
  <div id="results" class="space-y-8"></div>
</section>

{% include "footer.njk" %}
{% include "analytics.njk" %}

<script>
(function(){
  let index = [];
  const input = document.getElementById('searchInput');
  const results = document.getElementById('results');
  const count = document.getElementById('resultCount');

  fetch('/search-index.json')
    .then(r => r.json())
    .then(data => { index = data; renderResults(''); })
    .catch(() => { count.textContent = "Couldn't load the search index."; });

  function renderResults(query) {
    const q = query.trim().toLowerCase();
    if (!q) {
      results.innerHTML = '';
      count.textContent = 'Start typing to search.';
      return;
    }
    const matches = index.filter(item =>
      (item.title || '').toLowerCase().includes(q) ||
      (item.excerpt || '').toLowerCase().includes(q) ||
      (item.category || '').toLowerCase().includes(q)
    );
    count.textContent = matches.length + (matches.length === 1 ? ' result' : ' results');
    results.innerHTML = matches.map(item => `
      <a href="${item.url}" class="group block border-b border-gray-900 pb-8">
        <span class="text-xs uppercase tracking-widest text-gray-500">${item.category}</span>
        <h2 class="text-2xl serif text-gray-200 group-hover:text-white group-hover:italic transition-all duration-300 mt-2 mb-2">${item.title}</h2>
        <p class="text-sm text-gray-500 font-light">${item.excerpt}</p>
      </a>
    `).join('');
  }

  input.addEventListener('input', e => renderResults(e.target.value));
})();
</script>
</body>
</html>

---
permalink: "/index.html"
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Srijayee | Fashion &amp; Luxury Content Strategist</title>
<meta name="description" content="Writing brand narratives, building content strategy, and offering personal styling guidance for fashion and luxury brands.">
<meta property="og:title" content="Srijayee | Fashion & Luxury Content Strategist">
<meta property="og:description" content="Writing brand narratives, building content strategy, and offering personal styling guidance for fashion and luxury brands.">
<meta property="og:type" content="website">
<meta name="twitter:card" content="summary_large_image">
<link rel="sitemap" type="application/xml" href="/sitemap.xml">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Srijayee Ghosh",
  "alternateName": "Ivygstyles",
  "url": "https://ivygstyles.pages.dev/",
  "sameAs": [
    "{{ social.pinterest_url }}",
    "{{ social.instagram_url }}",
    "{{ social.facebook_url }}",
    "{{ social.linkedin_url }}"
  ],
  "jobTitle": "Fashion & Luxury Content Strategist",
  "alumniOf": "Bocconi University"
}
</script>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet">
<style>
  body{font-family:'Inter',sans-serif;background-color:#000;color:#fff;overflow-x:hidden;scroll-behavior:smooth;}
  .serif{font-family:'Playfair Display',serif;}
  a:focus-visible,button:focus-visible{outline:2px solid #fff;outline-offset:3px;}
  @media (prefers-reduced-motion: reduce){ *{transition-duration:0.01ms !important;} }
</style>
</head>
<body class="antialiased selection:bg-gray-700 selection:text-white">

{% set active = "home" %}
{% include "nav.njk" %}

<header class="max-w-screen-2xl mx-auto px-8 pt-12 pb-16 md:pt-20 md:pb-24 flex flex-col items-start">
  <p class="text-xs uppercase tracking-[0.2em] text-gray-500 mb-8 border-b border-gray-800 pb-2">{{ home.eyebrow }}</p>
  <h1 class="text-5xl md:text-7xl lg:text-8xl serif font-medium leading-tight text-gray-200 max-w-5xl">
    {{ home.heading_main }} <span class="italic text-gray-500 block md:inline mt-2 md:mt-0">{{ home.heading_emphasis }}</span>
  </h1>
  <p class="text-gray-400 font-light text-lg md:text-xl max-w-2xl mt-10 leading-relaxed">{{ home.subtext }}</p>
  <div class="flex flex-wrap gap-4 mt-10">
    <a href="{{ home.cta_primary_href }}" class="inline-block border border-gray-700 px-8 py-4 text-xs uppercase tracking-widest text-gray-300 hover:bg-white hover:text-black hover:border-white transition-all duration-500">{{ home.cta_primary_label }}</a>
    <a href="{{ home.cta_secondary_href }}" class="inline-block bg-white text-black px-8 py-4 text-xs uppercase tracking-widest hover:bg-gray-300 transition-all duration-500">{{ home.cta_secondary_label }}</a>
  </div>
</header>

<hr class="border-t border-gray-900 max-w-screen-2xl mx-auto">

<section id="featured" class="max-w-screen-xl mx-auto px-8 py-24 flex flex-col items-start space-y-16 md:space-y-24">
  {% set featuredCaseStudies = collections.caseStudies | onlyFeatured %}
  {% if featuredCaseStudies.length %}
    {% for c in featuredCaseStudies | limit(3) %}
    {% set numerals = ["I","II","III"] %}
    <a href="/client-work/{{ c.slug }}/" class="group flex items-center w-full cursor-pointer {{ 'ml-0 md:ml-32' if loop.index == 2 }}">
      <div class="w-16 md:w-32 flex-shrink-0 text-xl md:text-3xl serif font-bold text-gray-700 group-hover:text-white transition-colors duration-500">{{ numerals[loop.index0] }}</div>
      <div class="flex flex-col md:flex-row md:items-center space-y-4 md:space-y-0 md:space-x-8 w-full">
        <h2 class="text-4xl md:text-6xl serif font-medium text-gray-300 group-hover:text-white group-hover:italic transition-all duration-500">{{ c.client }}</h2>
        {% if c.home_tag %}
        <div class="text-gray-500 font-light text-sm max-w-md border-l border-gray-800 pl-4">
          <span class="block text-gray-300 mb-1 uppercase tracking-widest text-xs">{{ c.home_tag }}</span>
          {{ c.description }}
        </div>
        {% endif %}
      </div>
    </a>
    {% endfor %}
  {% else %}
    <p class="text-gray-600 text-sm">Featured work will appear here once published.</p>
  {% endif %}
</section>

<section id="talent" class="max-w-screen-xl mx-auto px-8 py-24 border-t border-gray-900 mt-12">
  <div class="grid grid-cols-1 md:grid-cols-12 gap-16 items-center">
    <div class="md:col-span-5 w-full aspect-[4/5] overflow-hidden bg-gray-900">
      <img src="/content/images/about-portrait.jpg" alt="Srijayee, fashion and luxury content strategist" class="w-full h-full object-cover grayscale contrast-125 hover:grayscale-0 transition-all duration-1000 ease-in-out cursor-pointer">
    </div>
    <div class="md:col-span-7 space-y-8">
      <h3 class="text-xs uppercase tracking-[0.3em] text-gray-500">{{ home.talent_eyebrow }}</h3>
      <h2 class="text-4xl md:text-5xl serif leading-tight text-gray-200">{{ home.talent_heading_main }} <br><span class="italic text-gray-500">{{ home.talent_heading_emphasis }}</span></h2>
      <div class="space-y-6 text-gray-400 font-light leading-relaxed max-w-2xl text-sm md:text-base">
        {% for p in home.talent_bio.split("\n\n") %}<p>{{ p }}</p>{% endfor %}
      </div>
      <a href="{{ home.talent_cta_href }}" class="inline-block text-xs uppercase tracking-widest border-b border-gray-700 pb-1 text-gray-300 hover:text-white hover:border-white transition">{{ home.talent_cta_label }}</a>
    </div>
  </div>
</section>

<section id="offerings" class="max-w-screen-xl mx-auto px-8 py-24 border-t border-gray-900">
  <p class="text-xs uppercase tracking-[0.2em] text-gray-500 mb-16 text-center">{{ home.offerings_eyebrow }}</p>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-8 divide-y md:divide-y-0 md:divide-x divide-gray-900">
    {% for o in home.offerings %}
    <div class="pt-8 md:pt-0 md:px-8 flex flex-col items-start">
      <span class="serif italic text-xl text-gray-600 mb-6">{{ o.roman }}</span>
      <h3 class="text-xl serif mb-4 text-gray-200">{{ o.title }}</h3>
      <p class="text-sm text-gray-500 font-light leading-relaxed flex-grow">{{ o.description }}</p>
      <a href="{{ o.link_href }}" class="mt-6 text-xs uppercase tracking-widest border-b border-gray-700 pb-1 text-gray-400 hover:text-white hover:border-white transition">{{ o.link_label }}</a>
    </div>
    {% endfor %}
  </div>
  <div class="mt-20 text-center">
    <a href="{{ home.closing_cta_href }}" class="inline-block border border-gray-700 px-10 py-5 text-xs uppercase tracking-widest text-gray-300 hover:bg-white hover:text-black hover:border-white transition-all duration-500">{{ home.closing_cta_label }}</a>
  </div>
</section>

{% include "footer.njk" %}

{% include "analytics.njk" %}
</body>
</html>

---
permalink: "/index.html"
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<title>Srijayee | Fashion &amp; Luxury Content Strategist</title>
<link rel="canonical" href="https://ivygstyles.pages.dev{{ page.url }}">
<meta name="description" content="Writing brand narratives, building content strategy, and offering personal styling guidance for fashion and luxury brands.">
<meta property="og:title" content="Srijayee | Fashion & Luxury Content Strategist">
<meta property="og:description" content="Writing brand narratives, building content strategy, and offering personal styling guidance for fashion and luxury brands.">
<meta property="og:type" content="website">
<meta name="twitter:card" content="summary_large_image">
<link rel="sitemap" type="application/xml" href="/sitemap.xml">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Srijayee Ghosh",
  "alternateName": "Ivygstyles",
  "url": "https://ivygstyles.pages.dev/",
  "sameAs": [
    "{{ social.pinterest_url }}",
    "{{ social.instagram_url }}",
    "{{ social.facebook_url }}",
    "{{ social.linkedin_url }}"
  ],
  "jobTitle": "Fashion & Luxury Content Strategist",
  "alumniOf": "Bocconi University"
}
</script>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#FBFBFA; --paper-deep:#EAE8E4;
    --ink:#1A1A1A; --ink-soft:#4A443C;
    --muted:#8C8880; --faint:#EFEDE8;
    --line:#E6E3DD; --brass:#B9975A;
  }

  body{font-family:'Plus Jakarta Sans',sans-serif;background-color:var(--paper);color:var(--ink);overflow-x:hidden;scroll-behavior:smooth;}
  .serif{font-family:'Cormorant Garamond',serif;}
  a:focus-visible,button:focus-visible{outline:2px solid var(--ink);outline-offset:3px;}
  @media (prefers-reduced-motion: reduce){ *{transition-duration:0.01ms !important;} }

  /* Aurora Background — adapted from Aceternity UI, recolored to the site's
     black/gold palette and rebuilt in vanilla CSS (the site has no React/shadcn). */
  .aurora-wrap{position:relative;overflow:hidden;}
  .aurora-bg{
    pointer-events:none;position:absolute;inset:0;z-index:0;overflow:hidden;
  }
  .aurora-bg-layer{
    position:absolute;top:-20%;left:-20%;width:140%;height:140%;
    background-image:
      repeating-linear-gradient(100deg,var(--brass) 6%,var(--ink) 14%,var(--ink-soft) 20%,var(--faint) 28%,var(--brass) 36%),
      repeating-linear-gradient(100deg,var(--paper) 0%,var(--paper) 6%,transparent 10%,transparent 14%,var(--paper) 18%);
    background-size:200% 200%,150% 100%;
    filter:blur(60px) saturate(140%);
    opacity:0.35;
    mix-blend-mode:screen;
    will-change:transform;
    animation:aurora 25s ease-in-out infinite alternate;
  }
  .aurora-bg::after{
    content:"";position:absolute;inset:0;z-index:1;
    background:radial-gradient(ellipse at 50% 0%,rgba(0,0,0,0) 0%,var(--paper) 75%);
  }
  @keyframes aurora{
    from{transform:translate3d(0,0,0) rotate(0deg);}
    to{transform:translate3d(-8%,4%,0) rotate(4deg);}
  }
  @media (prefers-reduced-motion: reduce){ .aurora-bg-layer{animation:none;} }
</style>
</head>
<body class="antialiased selection:bg-[var(--line)] selection:text-[var(--ink)]">

{% set active = "home" %}
{% include "nav.njk" %}

<div class="aurora-wrap">
  <div class="aurora-bg" aria-hidden="true"><div class="aurora-bg-layer"></div></div>
  <header class="relative z-10 max-w-screen-2xl mx-auto px-8 pt-12 pb-16 md:pt-20 md:pb-24 flex flex-col items-start">
    <p data-hero-reveal class="text-[11px] uppercase tracking-[0.25em] font-medium text-[var(--muted)] mb-8">{{ home.eyebrow }}</p>
    <h1 data-hero-reveal class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl serif font-light leading-[1.05] tracking-tight text-[var(--ink)] max-w-5xl">
      {{ home.heading_main }} <span class="italic text-[var(--ink-soft)] block md:inline mt-2 md:mt-0">{{ home.heading_emphasis }}</span>
    </h1>
    <p data-hero-reveal class="text-[var(--ink-soft)] font-light text-sm md:text-base max-w-xl mt-10 leading-relaxed tracking-wide">{{ home.subtext }}</p>
    <div data-hero-reveal class="flex flex-wrap gap-4 mt-10">
      <a href="{{ home.cta_primary_href }}" data-magnetic class="inline-block border border-[var(--line)] px-8 py-4 text-xs uppercase tracking-[0.2em] text-[var(--ink-soft)] hover:bg-[var(--ink)] hover:text-[var(--paper)] hover:border-[var(--ink)] transition-all duration-700 ease-[cubic-bezier(0.25,1,0.5,1)]">{{ home.cta_primary_label }}</a>
      <a href="{{ home.cta_secondary_href }}" data-magnetic class="inline-block bg-[var(--ink)] text-[var(--paper)] px-8 py-4 text-xs uppercase tracking-[0.2em] hover:bg-[var(--ink-soft)] transition-all duration-700 ease-[cubic-bezier(0.25,1,0.5,1)]">{{ home.cta_secondary_label }}</a>
    </div>
  </header>
</div>

<hr class="border-t border-[var(--line)] max-w-screen-2xl mx-auto">

<section id="featured" class="w-full">
  <div class="max-w-screen-2xl mx-auto px-8 pt-20 pb-10 md:pt-28 md:pb-14 flex flex-col md:flex-row md:items-baseline justify-between gap-4">
    <span class="text-[11px] tracking-[0.25em] uppercase font-medium text-[var(--muted)]">{{ home.featured_eyebrow }}</span>
    <h2 class="serif font-light text-4xl md:text-5xl text-[var(--ink)]">{{ home.featured_heading }}</h2>
  </div>
  {% set featuredCaseStudies = collections.caseStudies | onlyFeatured %}
  {% if featuredCaseStudies.length %}
    {% for c in featuredCaseStudies | limit(3) %}
    {% set numerals = ["I","II","III"] %}
    <a href="/client-work/{{ c.slug }}/" data-reveal data-reveal-group="featured" class="group relative block w-full h-[70vh] md:h-[92vh] overflow-hidden border-b border-[var(--line)]">
      {% if c.image %}
      <img src="{{ c.image }}" alt="{{ c.client }}" class="absolute inset-0 w-full h-full object-cover grayscale contrast-125 scale-105 group-hover:grayscale-0 group-hover:scale-100 transition-all duration-[1600ms] ease-out">
      <div class="absolute inset-0 bg-gradient-to-t from-black via-black/20 to-black/10"></div>
      {% else %}
      <div class="absolute inset-0 bg-[var(--paper-deep)]"></div>
      {% endif %}
      <div class="relative z-10 h-full w-full max-w-screen-2xl mx-auto px-8 flex flex-col justify-end pb-12 md:pb-16">
        <div class="flex items-baseline gap-6">
          <span class="text-lg md:text-2xl serif italic text-[var(--brass)]">{{ numerals[loop.index0] }}</span>
          <h2 class="text-5xl md:text-8xl serif font-medium text-[var(--ink)] group-hover:italic transition-all duration-500">{{ c.client }}</h2>
        </div>
        {% if c.home_tag %}
        <div class="mt-6 max-w-lg">
          <span class="block text-[var(--brass)] mb-2 uppercase tracking-widest text-xs">{{ c.home_tag }}</span>
          <p class="text-[var(--muted)] font-light text-sm md:text-base">{{ c.description }}</p>
        </div>
        {% endif %}
      </div>
    </a>
    {% endfor %}
  {% else %}
  <div class="max-w-screen-xl mx-auto px-8 py-24">
    <p class="text-[var(--muted)] text-sm">Featured work will appear here once published.</p>
  </div>
  {% endif %}
</section>

<section id="journal" class="max-w-screen-md mx-auto px-8 py-24 md:py-36 border-t border-[var(--line)]">
  <div data-reveal class="text-center space-y-4 mb-16 md:mb-20">
    <span class="text-[11px] tracking-[0.25em] uppercase font-medium text-[var(--muted)]">{{ home.journal_eyebrow }}</span>
    <h2 class="serif font-light text-4xl md:text-5xl text-[var(--ink)]">{{ home.journal_heading }}</h2>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-16 md:gap-12">
    {% for j in home.journal_items %}
    <div data-reveal data-reveal-group="journal" class="flex flex-col items-start">
      <span class="text-[10px] tracking-[0.2em] uppercase font-medium text-[var(--brass)] mb-3">{{ j.category }}</span>
      <h3 class="serif text-2xl md:text-3xl font-light text-[var(--ink)] mb-4 leading-snug">{{ j.title }}</h3>
      <p class="text-sm text-[var(--muted)] font-light leading-relaxed">{{ j.description }}</p>
      <a href="{{ j.link_href }}" class="mt-6 text-xs uppercase tracking-widest border-b border-[var(--line)] pb-1 text-[var(--ink-soft)] hover:text-[var(--brass)] hover:border-[var(--ink)] transition">{{ j.link_label }} →</a>
    </div>
    {% endfor %}
  </div>
</section>

<section id="talent" class="max-w-screen-xl mx-auto px-8 py-24 border-t border-[var(--line)] mt-12">
  <div class="grid grid-cols-1 md:grid-cols-12 gap-16 items-center">
    <div data-reveal data-reveal-image class="md:col-span-5 w-full aspect-[4/5] overflow-hidden bg-[var(--paper-deep)]">
      <img src="/content/images/about-portrait.jpg" alt="Srijayee, fashion and luxury content strategist" class="w-full h-full object-cover grayscale contrast-125 hover:grayscale-0 transition-all duration-1000 ease-in-out cursor-pointer">
    </div>
    <div data-reveal class="md:col-span-7 space-y-8">
      <h3 class="text-xs uppercase tracking-[0.3em] text-[var(--muted)]">{{ home.talent_eyebrow }}</h3>
      <h2 class="text-4xl md:text-5xl serif leading-tight text-[var(--ink)]">{{ home.talent_heading_main }} <br><span class="italic text-[var(--muted)]">{{ home.talent_heading_emphasis }}</span></h2>
      <div class="space-y-6 text-[var(--ink-soft)] font-light leading-relaxed max-w-2xl text-sm md:text-base">
        {% for p in home.talent_bio.split("\n\n") %}<p>{{ p }}</p>{% endfor %}
      </div>
      <a href="{{ home.talent_cta_href }}" class="inline-block text-xs uppercase tracking-widest border-b border-[var(--line)] pb-1 text-[var(--ink-soft)] hover:text-[var(--brass)] hover:border-[var(--ink)] transition">{{ home.talent_cta_label }}</a>
    </div>
  </div>
</section>

<section id="offerings" class="max-w-screen-xl mx-auto px-8 py-24 border-t border-[var(--line)]">
  <p class="text-xs uppercase tracking-[0.2em] text-[var(--muted)] mb-16 text-center">{{ home.offerings_eyebrow }}</p>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-8 divide-y md:divide-y-0 md:divide-x divide-[var(--line)]">
    {% for o in home.offerings %}
    <div data-reveal data-reveal-group="offerings" class="pt-8 md:pt-0 md:px-8 flex flex-col items-start">
      <span class="serif italic text-xl text-[var(--muted)] mb-6">{{ o.roman }}</span>
      <h3 class="text-xl serif mb-4 text-[var(--ink)]">{{ o.title }}</h3>
      <p class="text-sm text-[var(--muted)] font-light leading-relaxed flex-grow">{{ o.description }}</p>
      <a href="{{ o.link_href }}" class="mt-6 text-xs uppercase tracking-widest border-b border-[var(--line)] pb-1 text-[var(--ink-soft)] hover:text-[var(--brass)] hover:border-[var(--ink)] transition">{{ o.link_label }}</a>
    </div>
    {% endfor %}
  </div>
  <div class="mt-20 text-center">
    <a href="{{ home.closing_cta_href }}" data-magnetic class="inline-block border border-[var(--line)] px-10 py-5 text-xs uppercase tracking-widest text-[var(--ink-soft)] hover:bg-[var(--ink)] hover:text-[var(--paper)] hover:border-[var(--ink)] transition-all duration-500">{{ home.closing_cta_label }}</a>
  </div>
</section>

{% include "footer.njk" %}

{% include "animations.njk" %}
{% include "analytics.njk" %}
</body>
</html>

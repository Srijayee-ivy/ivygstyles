---
pagination:
  data: collections.trendReports
  size: 1
  alias: report
permalink: "/trend-reports/{{ report.slug }}/index.html"
eleventyComputed:
  title: "{{ report.title }} | Srijayee"
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
<meta name="description" content="{{ report.summary }}">
<script>tailwind = { config: { theme: { extend: { colors: { gold: "#C9A961" } } } } };</script>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet">
<style>
  body{font-family:'Inter',sans-serif;background-color:#000;color:#fff;overflow-x:hidden;}
  .serif{font-family:'Playfair Display',serif;}
  a:focus-visible{outline:2px solid #fff;outline-offset:3px;}
</style>
</head>
<body class="antialiased selection:bg-gray-700 selection:text-white">

{% set active = "trend-reports" %}
{% include "nav.njk" %}
{% set breadcrumbs = [{"label": "Home", "url": "/"}, {"label": "Trend Reports", "url": "/trend-reports/"}, {"label": report.title, "url": "#"}] %}
{% include "breadcrumbs.njk" %}

<header class="max-w-screen-md mx-auto px-8 pt-10 pb-8">
  <p class="text-xs text-gray-600 mb-4">{{ report.date | dateFormat }}</p>
  <h1 class="text-3xl md:text-5xl serif leading-tight text-gray-100 mb-6">{{ report.title }}</h1>
  <p class="text-gray-400 font-light leading-relaxed text-lg">{{ report.summary }}</p>
</header>

<section class="max-w-screen-md mx-auto px-8 py-10 border-t border-gray-900">
  <p class="text-xs uppercase tracking-widest text-gray-600 mb-4">Emerging Trends</p>
  <ul class="space-y-3 mb-10">
    {% for item in report.emerging_trends %}
    <li class="flex gap-3 text-gray-400 font-light leading-relaxed"><span class="text-gray-700 flex-shrink-0">→</span><span>{{ item }}</span></li>
    {% endfor %}
  </ul>

  {% if report.market_observations %}
  <p class="text-xs uppercase tracking-widest text-gray-600 mb-3">Market Observations</p>
  <p class="text-gray-400 font-light leading-relaxed mb-10">{{ report.market_observations }}</p>
  {% endif %}

  {% if report.strategic_implications %}
  <p class="text-xs uppercase tracking-widest text-gray-600 mb-3">Strategic Implications</p>
  <p class="text-gray-400 font-light leading-relaxed">{{ report.strategic_implications }}</p>
  {% endif %}
</section>

<footer class="max-w-screen-md mx-auto px-8 py-16 border-t border-gray-900 text-center">
  <a href="/trend-reports/" class="text-xs uppercase tracking-widest border-b border-gray-700 pb-1 text-gray-300 hover:text-gold hover:border-gold transition">← All Trend Reports</a>
</footer>

{% include "footer.njk" %}
{% include "analytics.njk" %}
{% include "motion.njk" %}
</body>
</html>

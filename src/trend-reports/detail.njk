---
pagination:
  data: collections.trendReports
  size: 1
  alias: report
permalink: "/trend-reports/{{ report.slug }}/index.html"
eleventyComputed:
  title: "{{ report.title }} | Srijayee"
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<title>{{ title }}</title>
<link rel="canonical" href="https://ivygstyles.pages.dev{{ page.url }}">
<meta name="description" content="{{ report.summary }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ report.summary }}">
<meta property="og:type" content="article">
{% if report.image %}<meta property="og:image" content="https://ivygstyles.pages.dev{{ report.image }}">{% endif %}
<meta name="twitter:card" content="summary_large_image">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ report.title | dump | safe }},
  "description": {{ report.summary | dump | safe }},
  "datePublished": "{{ report.date | isoDate }}",
  "author": { "@type": "Person", "name": "Srijayee Ghosh" }
}
</script>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#FBFBFA; --paper-deep:#EAE8E4;
    --ink:#1A1A1A; --ink-soft:#4A443C;
    --muted:#8C8880; --faint:#EFEDE8;
    --line:#E6E3DD; --brass:#B9975A;
  }

  body{font-family:'Plus Jakarta Sans',sans-serif;background-color:var(--paper);color:var(--ink);overflow-x:hidden;}
  .serif{font-family:'Cormorant Garamond',serif;}
  a:focus-visible{outline:2px solid var(--ink);outline-offset:3px;}
</style>
</head>
<body class="antialiased selection:bg-[var(--line)] selection:text-[var(--ink)]">

{% set active = "trend-reports" %}
{% include "nav.njk" %}
{% set breadcrumbs = [{"label": "Home", "url": "/"}, {"label": "Trend Reports", "url": "/trend-reports/"}, {"label": report.title, "url": "#"}] %}
{% include "breadcrumbs.njk" %}

<header class="max-w-screen-md mx-auto px-8 pt-10 pb-8">
  <p class="text-xs text-[var(--muted)] mb-4">{{ report.date | dateFormat }}</p>
  <h1 class="text-3xl md:text-5xl serif leading-tight text-[var(--ink)] mb-6">{{ report.title }}</h1>
  <p class="text-[var(--ink-soft)] font-light leading-relaxed text-lg">{{ report.summary }}</p>
</header>

<section class="max-w-screen-md mx-auto px-8 py-10 border-t border-[var(--line)]">
  <p class="text-xs uppercase tracking-widest text-[var(--muted)] mb-4">Emerging Trends</p>
  <ul class="space-y-3 mb-10">
    {% for item in report.emerging_trends %}
    <li class="flex gap-3 text-[var(--ink-soft)] font-light leading-relaxed"><span class="text-[var(--faint)] flex-shrink-0">→</span><span>{{ item }}</span></li>
    {% endfor %}
  </ul>

  {% if report.market_observations %}
  <p class="text-xs uppercase tracking-widest text-[var(--muted)] mb-3">Market Observations</p>
  <p class="text-[var(--ink-soft)] font-light leading-relaxed mb-10">{{ report.market_observations }}</p>
  {% endif %}

  {% if report.strategic_implications %}
  <p class="text-xs uppercase tracking-widest text-[var(--muted)] mb-3">Strategic Implications</p>
  <p class="text-[var(--ink-soft)] font-light leading-relaxed">{{ report.strategic_implications }}</p>
  {% endif %}
</section>

<footer class="max-w-screen-md mx-auto px-8 py-16 border-t border-[var(--line)] text-center">
  <a href="/trend-reports/" class="text-xs uppercase tracking-widest border-b border-[var(--line)] pb-1 text-[var(--ink-soft)] hover:text-[var(--brass)] hover:border-[var(--ink)] transition">← All Trend Reports</a>
</footer>

{% include "footer.njk" %}
{% include "animations.njk" %}
{% include "analytics.njk" %}
</body>
</html>

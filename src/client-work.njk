---
permalink: "/client-work.html"
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Client Work | Srijayee</title>
<meta name="description" content="Content strategy case studies for Manyavar, Taneira, Tanishq, and other fashion & luxury brands.">
<meta property="og:title" content="Client Work | Srijayee">
<meta property="og:description" content="Content strategy case studies for Manyavar, Taneira, Tanishq, and other fashion & luxury brands.">
<meta property="og:type" content="website">
<meta name="twitter:card" content="summary_large_image">
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#000000; --paper-deep:#14110B;
    --ink:#D4AF37; --ink-soft:#A08847;
    --muted:#D6CBB0; --faint:#5C4F2E;
    --line:#2A2419; --brass:#F0C550;
  }

  body{font-family:'Inter',sans-serif;background-color:var(--paper);color:var(--ink);overflow-x:hidden;}
  .serif{font-family:'Playfair Display',serif;}
  a:focus-visible,button:focus-visible{outline:2px solid var(--ink);outline-offset:3px;}
</style>
</head>
<body class="antialiased selection:bg-[var(--line)] selection:text-[var(--ink)]">

{% set active = "client-work" %}
{% include "nav.njk" %}

<header class="max-w-screen-xl mx-auto px-8 pt-12 pb-20">
  <p class="text-xs uppercase tracking-[0.2em] text-[var(--muted)] mb-6">{{ clientWork.eyebrow }}</p>
  <h1 data-hero-reveal class="text-4xl md:text-6xl serif font-medium leading-tight text-[var(--ink)] max-w-3xl">{{ clientWork.heading }}</h1>
</header>

<section class="max-w-screen-xl mx-auto px-8 pb-24 border-t border-[var(--line)]">
  {% set numerals = ["I","II","III","IV","V","VI","VII","VIII","IX","X","XI","XII"] %}
  {% if collections.caseStudies.length %}
    {% for c in collections.caseStudies %}
    {% set flip = (loop.index0 % 2 == 1) %}
    <a href="/client-work/{{ c.slug }}/" data-reveal class="group grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-14 items-center py-16 md:py-24 {{ 'border-b border-[var(--line)]' if not loop.last }}">
      {% if c.image %}
      <div class="md:col-span-6 {{ 'md:order-2' if flip else 'md:order-1' }}">
        <div class="aspect-[4/5] md:aspect-[16/11] overflow-hidden bg-[var(--paper-deep)]">
          <img data-reveal-image src="{{ c.image }}" alt="{{ c.client }}" class="w-full h-full object-cover grayscale contrast-125 group-hover:grayscale-0 transition-all duration-1000 ease-in-out">
        </div>
      </div>
      {% endif %}
      <div class="{{ 'md:col-span-6' if c.image else 'md:col-span-12' }} {{ ('md:order-1' if flip else 'md:order-2') if c.image else '' }}">
        <span class="serif italic text-2xl text-[var(--faint)] group-hover:text-[var(--muted)] transition-colors duration-500 block mb-4">{{ numerals[loop.index0] }}</span>
        <div class="text-xs uppercase tracking-widest text-[var(--muted)] mb-3">{{ c.client }}</div>
        <h2 class="text-3xl md:text-5xl serif text-[var(--ink-soft)] group-hover:text-[var(--brass)] group-hover:italic transition-all duration-500 mb-5 max-w-lg">{{ c.title }}</h2>
        <p class="text-[var(--muted)] font-light leading-relaxed max-w-md mb-6">{{ c.description }}</p>
        <span class="text-xs uppercase tracking-widest border-b border-[var(--line)] pb-1 text-[var(--ink-soft)] group-hover:text-[var(--brass)] group-hover:border-[var(--ink)] transition">Read →</span>
      </div>
    </a>
    {% endfor %}
  {% else %}
    <div class="py-14 text-[var(--muted)] text-sm">Case studies will appear here once published in the CMS.</div>
  {% endif %}
</section>

{% include "footer.njk" %}

{% include "animations.njk" %}
{% include "analytics.njk" %}
</body>
</html>

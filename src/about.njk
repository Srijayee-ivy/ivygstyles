---
permalink: "/about.html"
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<title>About | Srijayee</title>
<link rel="canonical" href="https://ivygstyles.pages.dev{{ page.url }}">
<meta name="description" content="Fashion & luxury content strategist — background, credentials, and how I work.">
<meta property="og:title" content="About | Srijayee">
<meta property="og:description" content="Fashion & luxury content strategist — background, credentials, and how I work.">
<meta property="og:type" content="website">
<meta name="twitter:card" content="summary_large_image">
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#FBFBFA; --paper-deep:#EAE8E4;
    --ink:#1A1A1A; --ink-soft:#4A443C;
    --muted:#8C8880; --faint:#EFEDE8;
    --line:#E6E3DD; --brass:#B9975A;
  }

  body{font-family:'Plus Jakarta Sans',sans-serif;background-color:var(--paper);color:var(--ink);overflow-x:hidden;}
  .serif{font-family:'Cormorant Garamond',serif;}
  a:focus-visible,button:focus-visible{outline:2px solid var(--ink);outline-offset:3px;}
  @media(prefers-reduced-motion:reduce){ *{transition-duration:0.01ms !important;} }
</style>
</head>
<body class="antialiased selection:bg-[var(--line)] selection:text-[var(--ink)]">

{% set active = "about" %}
{% include "nav.njk" %}

<section class="max-w-screen-xl mx-auto px-8 py-12 md:py-20">
  <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-16 items-center">
    <div class="md:col-span-5 w-full aspect-[4/5] overflow-hidden bg-[var(--paper-deep)]">
      <img data-reveal data-reveal-image src="{{ about.portrait or '/content/images/about-portrait.jpg' }}" alt="Srijayee — Fashion & Luxury Content Strategist" class="w-full h-full object-cover object-[center_20%] grayscale contrast-125 hover:grayscale-0 transition-all duration-1000 ease-in-out cursor-pointer">
    </div>
    <div data-reveal class="md:col-span-7 space-y-8">
      <p class="text-xs uppercase tracking-[0.2em] text-[var(--muted)]">{{ about.eyebrow }}</p>
      <h1 class="text-4xl md:text-5xl serif leading-tight text-[var(--ink)]">{{ about.heading_main }} <br><span class="italic text-[var(--muted)]">{{ about.heading_emphasis }}</span></h1>
      <div class="space-y-6 text-[var(--ink-soft)] font-light leading-relaxed max-w-2xl text-sm md:text-base">
        {% for p in about.bio.split("\n\n") %}<p>{{ p }}</p>{% endfor %}
      </div>
      {% if social.portfolio_url %}
      <a href="{{ social.portfolio_url }}" target="_blank" rel="noopener" class="inline-block text-xs uppercase tracking-widest border-b border-[var(--line)] pb-1 text-[var(--ink-soft)] hover:text-[var(--brass)] hover:border-[var(--ink)] transition">{{ about.portfolio_link_label }}</a>
      {% endif %}
    </div>
  </div>
</section>

<section class="max-w-screen-xl mx-auto px-8 py-24 border-t border-[var(--line)]">
  <p class="text-xs uppercase tracking-[0.2em] text-[var(--muted)] mb-12">{{ about.credentials_eyebrow }}</p>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-8 divide-y md:divide-y-0 md:divide-x divide-[var(--line)]">
    {% for c in about.credentials %}
    <div data-reveal data-reveal-group="credentials" class="pt-8 md:pt-0 md:px-8">
      <h3 class="text-xl serif mb-3 text-[var(--ink)]">{{ c.title }}</h3>
      <p class="text-sm text-[var(--muted)] font-light leading-relaxed">{{ c.description }}</p>
    </div>
    {% endfor %}
  </div>
</section>

{% include "footer.njk" %}

{% include "animations.njk" %}
{% include "analytics.njk" %}
</body>
</html>

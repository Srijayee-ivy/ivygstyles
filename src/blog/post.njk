---
pagination:
  data: collections.posts
  size: 1
  alias: post
permalink: "/blog/{{ post.slug }}/index.html"
eleventyComputed:
  title: "{{ post.title }} | Srijayee"
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
<meta name="description" content="{{ post.excerpt or post.title }}">
<meta property="og:title" content="{{ post.title }} | Srijayee">
<meta property="og:description" content="{{ post.excerpt or post.title }}">
<meta property="og:type" content="article">
{% if post.image %}<meta property="og:image" content="{{ post.image }}">{% endif %}
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet">
<style>
  body{font-family:'Inter',sans-serif;background-color:#000;color:#fff;overflow-x:hidden;line-height:1.7;}
  .serif{font-family:'Playfair Display',serif;}
  a:focus-visible{outline:2px solid #fff;outline-offset:3px;}
  #articleBody a{color:#e5e7eb;text-decoration:underline;text-underline-offset:3px;}
  #articleBody h2{font-family:'Playfair Display',serif;font-size:28px;margin:36px 0 12px;color:#e5e5e5;}
  #articleBody h3{font-family:'Playfair Display',serif;font-size:22px;margin:28px 0 10px;color:#e5e5e5;}
  #articleBody p{margin-bottom:18px;color:#9ca3af;font-size:16px;font-weight:300;}
</style>
</head>
<body class="antialiased selection:bg-gray-700 selection:text-white">

<header class="border-b border-gray-900 mb-16">
  <div class="max-w-screen-md mx-auto px-8 py-8 flex justify-between items-center">
    <a href="/"><h1 class="text-lg serif tracking-wide">Srijayee <span class="text-gray-500 italic">| The Ivygstyles Edit</span></h1></a>
    <div class="flex items-center gap-6">
      <a href="/search.html" aria-label="Search" class="text-gray-400 hover:text-white transition"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg></a>
      <a href="/blog/" class="text-xs uppercase tracking-widest border-b border-gray-700 pb-1 text-gray-300 hover:text-white hover:border-white transition">← All Works</a>
    </div>
  </div>
</header>

<div class="max-w-screen-md mx-auto px-8">
  <article>
    <p class="text-xs uppercase tracking-[0.2em] text-gray-500 mb-3">{{ post.category or "Journal" }}</p>
    <h1 class="text-3xl md:text-5xl serif leading-tight text-gray-100 mb-3">{{ post.title or "Untitled" }}</h1>
    <p class="text-sm text-gray-600 mb-10">{{ post.date | dateFormat }}</p>
    {% if post.image %}<img class="w-full max-h-[420px] object-cover mb-10 grayscale-[0.2]" src="{{ post.image }}" alt="">{% endif %}
    <div id="articleBody">{{ post.contentHtml | safe }}</div>
  </article>
</div>

<footer class="py-20 text-center mt-16">
  <a href="/blog/" class="text-xs uppercase tracking-widest border-b border-gray-700 pb-1 text-gray-300 hover:text-white hover:border-white transition">← Back to Selected Works</a>
</footer>

{% include "analytics.njk" %}
</body>
</html>

---
pagination:
  data: collections.posts
  size: 1
  alias: post
permalink: "/blog/{{ post.slug }}/index.html"
eleventyComputed:
  title: "{{ post.title }} | Srijayee"
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
<link rel="canonical" href="https://ivygstyles.pages.dev{{ page.url }}">
<meta name="description" content="{{ post.excerpt or post.title }}">
<meta property="og:title" content="{{ post.title }} | Srijayee">
<meta property="og:description" content="{{ post.excerpt or post.title }}">
<meta property="og:type" content="article">
{% if post.image %}<meta property="og:image" content="{{ post.image }}">{% endif %}
<meta name="twitter:card" content="summary_large_image">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ post.title | dump | safe }},
  "description": {{ (post.excerpt or post.title) | dump | safe }},
  "datePublished": "{{ post.date | isoDate }}",
  "author": { "@type": "Person", "name": "Srijayee Ghosh" },
  "publisher": { "@type": "Person", "name": "Srijayee Ghosh" }
  {% if post.image %}, "image": "https://ivygstyles.pages.dev{{ post.image }}"{% endif %}
}
</script>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#000000; --paper-deep:#14110B;
    --ink:#D4AF37; --ink-soft:#A08847;
    --muted:#D6CBB0; --faint:#5C4F2E;
    --line:#2A2419; --brass:#F0C550;
  }

  body{font-family:'Inter',sans-serif;background-color:var(--paper);color:var(--ink);overflow-x:hidden;line-height:1.7;}
  .serif{font-family:'Playfair Display',serif;}
  a:focus-visible{outline:2px solid var(--ink);outline-offset:3px;}
  #articleBody a{color:var(--ink);text-decoration:underline;text-underline-offset:3px;}
  #articleBody h2{font-family:'Playfair Display',serif;font-size:28px;margin:36px 0 12px;color:var(--ink);}
  #articleBody h3{font-family:'Playfair Display',serif;font-size:22px;margin:28px 0 10px;color:var(--ink);}
  #articleBody p{margin-bottom:18px;color:var(--muted);font-size:16px;font-weight:300;}
</style>
</head>
<body class="antialiased selection:bg-[var(--line)] selection:text-[var(--ink)]">

<header class="border-b border-[var(--line)] mb-16">
  <div class="max-w-screen-md mx-auto px-8 py-8 flex justify-between items-center">
    <a href="/"><h1 class="text-lg serif tracking-wide">Srijayee <span class="text-[var(--muted)] italic">| The Ivygstyles Edit</span></h1></a>
    <div class="flex items-center gap-6">
      <a href="/search.html" aria-label="Search" class="text-[var(--ink-soft)] hover:text-[var(--brass)] transition"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg></a>
      <a href="/blog/" class="text-xs uppercase tracking-widest border-b border-[var(--line)] pb-1 text-[var(--ink-soft)] hover:text-[var(--brass)] hover:border-[var(--ink)] transition">← All Works</a>
    </div>
  </div>
</header>

<div class="max-w-screen-md mx-auto px-8">
  <article>
    <p class="text-xs uppercase tracking-[0.2em] text-[var(--muted)] mb-3">{{ post.category or "Journal" }}</p>
    <h1 class="text-3xl md:text-5xl serif leading-tight text-[var(--ink)] mb-3">{{ post.title or "Untitled" }}</h1>
    <p class="text-sm text-[var(--muted)] mb-10">{{ post.date | dateFormat }}</p>
    {% if post.image %}<img class="w-full max-h-[420px] object-cover mb-10 grayscale-[0.2]" src="{{ post.image }}" alt="">{% endif %}
    <div id="articleBody">{{ post.contentHtml | safe }}</div>
  </article>
</div>

<footer class="py-20 text-center mt-16">
  <a href="/blog/" class="text-xs uppercase tracking-widest border-b border-[var(--line)] pb-1 text-[var(--ink-soft)] hover:text-[var(--brass)] hover:border-[var(--ink)] transition">← Back to Selected Works</a>
</footer>

{% include "animations.njk" %}
{% include "analytics.njk" %}
</body>
</html>

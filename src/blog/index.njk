---
permalink: "/blog/index.html"
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<title>Selected Works | Srijayee</title>
<link rel="canonical" href="https://ivygstyles.pages.dev{{ page.url }}">
<meta name="description" content="Writing, analysis, and case studies from Srijayee — fashion and luxury content strategist.">
<meta property="og:title" content="Selected Works | Srijayee">
<meta property="og:description" content="Writing, analysis, and case studies from Srijayee — fashion and luxury content strategist.">
<meta property="og:type" content="website">
<meta name="twitter:card" content="summary_large_image">
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#FBFBFA; --paper-deep:#EAE8E4;
    --ink:#1A1A1A; --ink-soft:#4A443C;
    --muted:#8C8880; --faint:#EFEDE8;
    --line:#E6E3DD; --brass:#B9975A;
  }

  body{font-family:'Plus Jakarta Sans',sans-serif;background-color:var(--paper);color:var(--ink);overflow-x:hidden;}
  .serif{font-family:'Cormorant Garamond',serif;}
  a:focus-visible,button:focus-visible{outline:2px solid var(--ink);outline-offset:3px;}
  .filter-btn.is-active{background:var(--ink);color:var(--paper);border-color:var(--ink);}
</style>
</head>
<body class="antialiased selection:bg-[var(--line)] selection:text-[var(--ink)]">

<header class="border-b border-[var(--line)]">
  <div class="max-w-screen-2xl mx-auto px-8 py-8 flex justify-between items-center">
    <a href="/"><h1 class="text-lg serif tracking-wide">Srijayee <span class="text-[var(--muted)] italic">| The Ivygstyles Edit</span></h1></a>
    <div class="flex items-center gap-6">
      <a href="/search.html" aria-label="Search" class="text-[var(--ink-soft)] hover:text-[var(--brass)] transition"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg></a>
      <a href="/" class="text-xs uppercase tracking-widest border-b border-[var(--line)] pb-1 text-[var(--ink-soft)] hover:text-[var(--brass)] hover:border-[var(--ink)] transition">← Home</a>
    </div>
  </div>
</header>

<div class="max-w-screen-xl mx-auto px-8">
  <div class="pt-16 pb-10 max-w-xl">
    <p class="text-xs uppercase tracking-[0.2em] text-[var(--muted)] mb-6">Selected Works</p>
    <h1 data-hero-reveal class="text-4xl md:text-6xl serif font-medium leading-tight text-[var(--ink)]">Writing, analysis, and case studies.</h1>
  </div>

  {% set categories = ["Luxury Brand Analysis","Fashion Trend Reports","Content Strategy for Fashion Brands","Styling & Editorial","Writing Samples","Beauty","Career"] %}
  <div class="flex gap-3 flex-wrap pb-12" id="filters">
    <button class="filter-btn is-active border border-[var(--ink)] text-xs uppercase tracking-widest px-5 py-2 transition" data-cat="all">All</button>
    {% for cat in categories %}
    <button class="filter-btn border border-[var(--line)] text-[var(--ink-soft)] text-xs uppercase tracking-widest px-5 py-2 hover:border-[var(--ink)] hover:text-[var(--brass)] transition" data-cat="{{ cat }}">{{ cat }}</button>
    {% endfor %}
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-[var(--paper-deep)] border border-[var(--line)] mb-24" id="posts">
    {% if collections.posts.length %}
      {% for p in collections.posts %}
      <a class="post-card group bg-[var(--paper)] p-10 flex flex-col gap-3" data-reveal data-reveal-group="posts" data-cat="{{ p.category }}" href="/blog/{{ p.slug }}/">
        <span class="text-xs uppercase tracking-widest text-[var(--muted)]">{{ p.category or "Journal" }}</span>
        <h3 class="text-2xl serif text-[var(--ink)] group-hover:text-[var(--brass)] group-hover:italic transition-all duration-500">{{ p.title or "Untitled" }}</h3>
        <p class="text-sm text-[var(--muted)] font-light flex-grow leading-relaxed">{{ p.excerpt or "" }}</p>
        <span class="text-xs text-[var(--muted)]">{{ p.date | dateFormat }}</span>
        <span class="text-xs uppercase tracking-widest border-b border-[var(--line)] pb-1 self-start text-[var(--ink-soft)] group-hover:text-[var(--brass)] group-hover:border-[var(--ink)] transition">Read →</span>
      </a>
      {% endfor %}
    {% else %}
      <div class="bg-[var(--paper)] py-20 text-center text-[var(--muted)] col-span-2">No posts published yet — your first one will appear here automatically.</div>
    {% endif %}
  </div>
</div>

<footer class="border-t border-[var(--line)] py-16">
  <div class="max-w-screen-2xl mx-auto px-8 text-center text-xs uppercase tracking-[0.15em] text-[var(--muted)]">
    <p>© 2026 Srijayee Ghosh. All rights reserved.</p>
  </div>
</footer>

<script>
document.getElementById('filters').addEventListener('click', e => {
  if (e.target.tagName !== 'BUTTON') return;
  document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('is-active'));
  e.target.classList.add('is-active');
  const cat = e.target.dataset.cat;
  document.querySelectorAll('.post-card').forEach(card => {
    card.style.display = (cat === 'all' || card.dataset.cat === cat) ? '' : 'none';
  });
});
</script>
{% include "animations.njk" %}
{% include "analytics.njk" %}
</body>
</html>

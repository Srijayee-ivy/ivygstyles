<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<title>Luxury Brand Analysis | Srijayee</title>
<link rel="canonical" href="https://ivygstyles.pages.dev{{ page.url }}">
<meta name="description" content="In-depth analysis of luxury and heritage brand positioning, visual identity, and digital presence.">
<meta property="og:title" content="Luxury Brand Analysis | Srijayee">
<meta property="og:description" content="In-depth analysis of luxury and heritage brand positioning, visual identity, and digital presence.">
<meta property="og:type" content="website">
<meta name="twitter:card" content="summary_large_image">
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#FBFBFA; --paper-deep:#EAE8E4;
    --ink:#1A1A1A; --ink-soft:#4A443C;
    --muted:#8C8880; --faint:#EFEDE8;
    --line:#E6E3DD; --brass:#B9975A;
  }

  body{font-family:'Plus Jakarta Sans',sans-serif;background-color:var(--paper);color:var(--ink);overflow-x:hidden;}
  .serif{font-family:'Cormorant Garamond',serif;}
  a:focus-visible{outline:2px solid var(--ink);outline-offset:3px;}
</style>
</head>
<body class="antialiased selection:bg-[var(--line)] selection:text-[var(--ink)]">

{% set active = "luxury-brand-analysis" %}
{% include "nav.njk" %}
{% set breadcrumbs = [{"label": "Home", "url": "/"}, {"label": "Luxury Brand Analysis", "url": "/luxury-brand-analysis/"}] %}
{% include "breadcrumbs.njk" %}

<header class="max-w-screen-xl mx-auto px-8 pt-8 pb-16 max-w-2xl">
  <p class="text-xs uppercase tracking-[0.2em] text-[var(--muted)] mb-6">Luxury Brand Analysis</p>
  <h1 data-hero-reveal class="text-4xl md:text-6xl serif font-medium leading-tight text-[var(--ink)]">How luxury brands actually build their identity.</h1>
</header>

<section class="max-w-screen-xl mx-auto px-8 pb-24">
  {% if collections.luxuryAnalyses.length %}
    {% for l in collections.luxuryAnalyses %}
    <a href="/luxury-brand-analysis/{{ l.slug }}/" data-reveal class="group block border-t border-[var(--line)] py-10 {{ 'border-b' if loop.last }}">
      <p class="text-xs uppercase tracking-widest text-[var(--muted)] mb-2">{{ l.brand_name }}</p>
      <h2 class="text-2xl md:text-3xl serif text-[var(--ink-soft)] group-hover:text-[var(--brass)] group-hover:italic transition-all duration-500 mb-3 max-w-2xl">{{ l.title }}</h2>
      <p class="text-[var(--muted)] font-light leading-relaxed max-w-xl">{{ l.overview }}</p>
    </a>
    {% endfor %}
  {% else %}
    <div class="py-14 text-[var(--muted)] text-sm">Brand analyses will appear here once published in the CMS.</div>
  {% endif %}
</section>

{% include "footer.njk" %}
{% include "animations.njk" %}
{% include "analytics.njk" %}
</body>
</html>

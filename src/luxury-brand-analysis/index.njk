permalink: "/luxury-brand-analysis/index.html"
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Luxury Brand Analysis | Srijayee</title>
<meta name="description" content="In-depth analysis of luxury and heritage brand positioning, visual identity, and digital presence.">
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet">
<style>
  body{font-family:'Inter',sans-serif;background-color:#000;color:#fff;overflow-x:hidden;}
  .serif{font-family:'Playfair Display',serif;}
  a:focus-visible{outline:2px solid #fff;outline-offset:3px;}
</style>
</head>
<body class="antialiased selection:bg-gray-700 selection:text-white">

{% set active = "luxury-brand-analysis" %}
{% include "nav.njk" %}
{% set breadcrumbs = [{"label": "Home", "url": "/"}, {"label": "Luxury Brand Analysis", "url": "/luxury-brand-analysis/"}] %}
{% include "breadcrumbs.njk" %}

<header class="max-w-screen-xl mx-auto px-8 pt-8 pb-16 max-w-2xl">
  <p class="text-xs uppercase tracking-[0.2em] text-gray-500 mb-6">Luxury Brand Analysis</p>
  <h1 class="text-4xl md:text-6xl serif font-medium leading-tight text-gray-200">How luxury brands actually build their identity.</h1>
</header>

<section class="max-w-screen-xl mx-auto px-8 pb-24">
  {% if collections.luxuryAnalyses.length %}
    {% for l in collections.luxuryAnalyses %}
    <a href="/luxury-brand-analysis/{{ l.slug }}/" class="group block border-t border-gray-900 py-10 {{ 'border-b' if loop.last }}">
      <p class="text-xs uppercase tracking-widest text-gray-600 mb-2">{{ l.brand_name }}</p>
      <h2 class="text-2xl md:text-3xl serif text-gray-300 group-hover:text-white group-hover:italic transition-all duration-500 mb-3 max-w-2xl">{{ l.title }}</h2>
      <p class="text-gray-500 font-light leading-relaxed max-w-xl">{{ l.overview }}</p>
    </a>
    {% endfor %}
  {% else %}
    <div class="py-14 text-gray-600 text-sm">Brand analyses will appear here once published in the CMS.</div>
  {% endif %}
</section>

{% include "footer.njk" %}
{% include "analytics.njk" %}
</body>
</html>

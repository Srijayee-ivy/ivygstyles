---
pagination:
  data: collections.luxuryAnalyses
  size: 1
  alias: analysis
permalink: "/luxury-brand-analysis/{{ analysis.slug }}/index.html"
eleventyComputed:
  title: "{{ analysis.title }} | Srijayee"
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
<link rel="canonical" href="https://ivygstyles.pages.dev{{ page.url }}">
<meta name="description" content="{{ analysis.overview }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ analysis.overview }}">
<meta property="og:type" content="article">
<meta name="twitter:card" content="summary_large_image">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ analysis.title | dump | safe }},
  "description": {{ analysis.overview | dump | safe }},
  "about": {{ analysis.brand_name | dump | safe }},
  "author": { "@type": "Person", "name": "Srijayee Ghosh" }
}
</script>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#000000; --paper-deep:#14110B;
    --ink:#D4AF37; --ink-soft:#A08847;
    --muted:#D6CBB0; --faint:#5C4F2E;
    --line:#2A2419; --brass:#F0C550;
  }

  body{font-family:'Inter',sans-serif;background-color:var(--paper);color:var(--ink);overflow-x:hidden;}
  .serif{font-family:'Playfair Display',serif;}
  a:focus-visible{outline:2px solid var(--ink);outline-offset:3px;}
</style>
</head>
<body class="antialiased selection:bg-[var(--line)] selection:text-[var(--ink)]">

{% set active = "luxury-brand-analysis" %}
{% include "nav.njk" %}
{% set breadcrumbs = [{"label": "Home", "url": "/"}, {"label": "Luxury Brand Analysis", "url": "/luxury-brand-analysis/"}, {"label": analysis.brand_name, "url": "#"}] %}
{% include "breadcrumbs.njk" %}

<header class="max-w-screen-md mx-auto px-8 pt-10 pb-8">
  <p class="text-xs uppercase tracking-widest text-[var(--muted)] mb-4">{{ analysis.brand_name }}{{ ' — ' + (analysis.date | dateFormat) if analysis.date }}</p>
  <h1 class="text-3xl md:text-5xl serif leading-tight text-[var(--ink)] mb-6">{{ analysis.title }}</h1>
  <p class="text-[var(--ink-soft)] font-light leading-relaxed text-lg">{{ analysis.overview }}</p>
</header>

<section class="max-w-screen-md mx-auto px-8 py-10 border-t border-[var(--line)] space-y-10">
  {% if analysis.history %}
  <div><p class="text-xs uppercase tracking-widest text-[var(--muted)] mb-3">History</p><p class="text-[var(--ink-soft)] font-light leading-relaxed">{{ analysis.history }}</p></div>
  {% endif %}
  {% if analysis.positioning %}
  <div><p class="text-xs uppercase tracking-widest text-[var(--muted)] mb-3">Positioning</p><p class="text-[var(--ink-soft)] font-light leading-relaxed">{{ analysis.positioning }}</p></div>
  {% endif %}
  {% if analysis.visual_identity %}
  <div><p class="text-xs uppercase tracking-widest text-[var(--muted)] mb-3">Visual Identity</p><p class="text-[var(--ink-soft)] font-light leading-relaxed">{{ analysis.visual_identity }}</p></div>
  {% endif %}
  {% if analysis.campaign_review %}
  <div><p class="text-xs uppercase tracking-widest text-[var(--muted)] mb-3">Campaign Review</p><p class="text-[var(--ink-soft)] font-light leading-relaxed">{{ analysis.campaign_review }}</p></div>
  {% endif %}
  {% if analysis.digital_presence %}
  <div><p class="text-xs uppercase tracking-widest text-[var(--muted)] mb-3">Digital Presence</p><p class="text-[var(--ink-soft)] font-light leading-relaxed">{{ analysis.digital_presence }}</p></div>
  {% endif %}
  {% if analysis.key_insights %}
  <div>
    <p class="text-xs uppercase tracking-widest text-[var(--muted)] mb-3">Key Insights</p>
    <ul class="space-y-3">
      {% for item in analysis.key_insights %}
      <li class="flex gap-3 text-[var(--ink-soft)] font-light leading-relaxed"><span class="text-[var(--faint)] flex-shrink-0">→</span><span>{{ item }}</span></li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}
  {% if analysis.conclusion %}
  <div class="border-t border-[var(--line)] pt-8"><p class="serif italic text-xl text-[var(--ink-soft)] leading-snug">{{ analysis.conclusion }}</p></div>
  {% endif %}
</section>

<footer class="max-w-screen-md mx-auto px-8 py-16 border-t border-[var(--line)] text-center">
  <a href="/luxury-brand-analysis/" class="text-xs uppercase tracking-widest border-b border-[var(--line)] pb-1 text-[var(--ink-soft)] hover:text-[var(--brass)] hover:border-[var(--ink)] transition">← All Brand Analyses</a>
</footer>

{% include "footer.njk" %}
{% include "animations.njk" %}
{% include "analytics.njk" %}
</body>
</html>

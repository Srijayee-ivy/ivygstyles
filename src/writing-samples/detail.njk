---
pagination:
  data: collections.writingSamples
  size: 1
  alias: sample
permalink: "/writing-samples/{{ sample.slug }}/index.html"
eleventyComputed:
  title: "{{ sample.title }} | Srijayee"
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<title>{{ title }}</title>
<link rel="canonical" href="https://ivygstyles.pages.dev{{ page.url }}">
<meta name="description" content="{{ sample.excerpt }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ sample.excerpt }}">
<meta property="og:type" content="article">
{% if sample.image %}<meta property="og:image" content="https://ivygstyles.pages.dev{{ sample.image }}">{% endif %}
<meta name="twitter:card" content="summary_large_image">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "name": {{ sample.title | dump | safe }},
  "description": {{ sample.excerpt | dump | safe }},
  "creator": { "@type": "Person", "name": "Srijayee Ghosh" }
}
</script>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#FBFBFA; --paper-deep:#EAE8E4;
    --ink:#1A1A1A; --ink-soft:#4A443C;
    --muted:#8C8880; --faint:#EFEDE8;
    --line:#E6E3DD; --brass:#B9975A;
  }

  body{font-family:'Plus Jakarta Sans',sans-serif;background-color:var(--paper);color:var(--ink);overflow-x:hidden;}
  .serif{font-family:'Cormorant Garamond',serif;}
  a:focus-visible{outline:2px solid var(--ink);outline-offset:3px;}
</style>
</head>
<body class="antialiased selection:bg-[var(--line)] selection:text-[var(--ink)]">

{% set active = "writing-samples" %}
{% include "nav.njk" %}
{% set breadcrumbs = [{"label": "Home", "url": "/"}, {"label": "Writing Samples", "url": "/writing-samples/"}, {"label": sample.title, "url": "#"}] %}
{% include "breadcrumbs.njk" %}

<header class="max-w-screen-md mx-auto px-8 pt-10 pb-8">
  <p class="text-xs uppercase tracking-widest text-[var(--muted)] mb-4">{{ sample.publication_type }}</p>
  <h1 class="text-3xl md:text-5xl serif leading-tight text-[var(--ink)] mb-6">{{ sample.title }}</h1>
  <p class="text-[var(--ink-soft)] font-light leading-relaxed text-lg">{{ sample.excerpt }}</p>
</header>

{% if sample.image %}
<div class="max-w-screen-md mx-auto px-8 pb-4">
  <div class="aspect-[16/9] overflow-hidden bg-[var(--paper-deep)]">
    <img data-reveal-image src="{{ sample.image }}" alt="{{ sample.title }}" class="w-full h-full object-cover">
  </div>
</div>
{% endif %}

<section class="max-w-screen-md mx-auto px-8 py-10 border-t border-[var(--line)] space-y-10">
  {% if sample.contentHtml %}
  <div id="writingSampleBody" class="prose-sample">{{ sample.contentHtml | safe }}</div>
  <style>
    #writingSampleBody{color:var(--ink-soft);font-weight:300;line-height:1.8;}
    #writingSampleBody p{margin-bottom:20px;}
    #writingSampleBody h2,#writingSampleBody h3{font-family:'Cormorant Garamond',serif;color:var(--ink);margin:32px 0 16px;}
    #writingSampleBody strong{color:var(--ink);font-weight:500;}
    #writingSampleBody ul,#writingSampleBody ol{margin:0 0 20px 20px;}
  </style>
  {% endif %}
  {% if sample.context %}
  <div><p class="text-xs uppercase tracking-widest text-[var(--muted)] mb-3">Context</p><p class="text-[var(--ink-soft)] font-light leading-relaxed">{{ sample.context }}</p></div>
  {% endif %}
  {% if sample.objective %}
  <div><p class="text-xs uppercase tracking-widest text-[var(--muted)] mb-3">Objective</p><p class="text-[var(--ink-soft)] font-light leading-relaxed">{{ sample.objective }}</p></div>
  {% endif %}
  {% if sample.skills_demonstrated %}
  <div>
    <p class="text-xs uppercase tracking-widest text-[var(--muted)] mb-3">Skills Demonstrated</p>
    <ul class="space-y-3">
      {% for item in sample.skills_demonstrated %}
      <li class="flex gap-3 text-[var(--ink-soft)] font-light leading-relaxed"><span class="text-[var(--faint)] flex-shrink-0">→</span><span>{{ item }}</span></li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}
  {% if sample.external_link %}
  <a href="{{ sample.external_link }}" class="inline-block text-xs uppercase tracking-widest border-b border-[var(--line)] pb-1 text-[var(--ink-soft)] hover:text-[var(--brass)] hover:border-[var(--ink)] transition">View Full Work →</a>
  {% endif %}
</section>

<footer class="max-w-screen-md mx-auto px-8 py-16 border-t border-[var(--line)] text-center">
  <a href="/writing-samples/" class="text-xs uppercase tracking-widest border-b border-[var(--line)] pb-1 text-[var(--ink-soft)] hover:text-[var(--brass)] hover:border-[var(--ink)] transition">← All Writing Samples</a>
</footer>

{% include "footer.njk" %}
{% include "animations.njk" %}
{% include "analytics.njk" %}
</body>
</html>

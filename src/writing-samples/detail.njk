---
pagination:
  data: collections.writingSamples
  size: 1
  alias: sample
permalink: "/writing-samples/{{ sample.slug }}/index.html"
eleventyComputed:
  title: "{{ sample.title }} | Srijayee"
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
<meta name="description" content="{{ sample.excerpt }}">
<script>tailwind = { config: { theme: { extend: { colors: { gold: "#C9A961" } } } } };</script>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet">
<style>
  body{font-family:'Inter',sans-serif;background-color:#000;color:#fff;overflow-x:hidden;}
  .serif{font-family:'Playfair Display',serif;}
  a:focus-visible{outline:2px solid #fff;outline-offset:3px;}
  #sampleBody{color:#d1d5db;font-weight:300;line-height:1.8;}
  #sampleBody p{margin-bottom:1.4em;}
  #sampleBody h1,#sampleBody h2,#sampleBody h3{font-family:'Playfair Display',serif;color:#f3f4f6;margin:1.4em 0 0.6em;font-weight:500;}
  #sampleBody h1{font-size:1.6rem;}
  #sampleBody h2{font-size:1.3rem;}
  #sampleBody ul,#sampleBody ol{margin:0.8em 0 1.4em 1.4em;}
  #sampleBody li{margin-bottom:0.5em;}
  #sampleBody strong{color:#f3f4f6;font-weight:500;}
</style>
</head>
<body class="antialiased selection:bg-gray-700 selection:text-white">

{% set active = "writing-samples" %}
{% include "nav.njk" %}
{% set breadcrumbs = [{"label": "Home", "url": "/"}, {"label": "Writing Samples", "url": "/writing-samples/"}, {"label": sample.title, "url": "#"}] %}
{% include "breadcrumbs.njk" %}

<header class="max-w-screen-md mx-auto px-8 pt-10 pb-8">
  <p class="text-xs uppercase tracking-widest text-gray-600 mb-4">{{ sample.publication_type }}</p>
  <h1 class="text-3xl md:text-5xl serif leading-tight text-gray-100 mb-6">{{ sample.title }}</h1>
  <p class="text-gray-400 font-light leading-relaxed text-lg">{{ sample.excerpt }}</p>
  {% if sample.contentHtml %}
  <div id="sampleBody" class="mt-10 border-t border-gray-900 pt-8">
    <p class="text-xs uppercase tracking-widest text-gold mb-6">Full Piece</p>
    {{ sample.contentHtml | safe }}
  </div>
  {% endif %}
</header>

<section class="max-w-screen-md mx-auto px-8 py-10 border-t border-gray-900 space-y-10">
  {% if sample.context %}
  <div><p class="text-xs uppercase tracking-widest text-gray-600 mb-3">Context</p><p class="text-gray-400 font-light leading-relaxed">{{ sample.context }}</p></div>
  {% endif %}
  {% if sample.objective %}
  <div><p class="text-xs uppercase tracking-widest text-gray-600 mb-3">Objective</p><p class="text-gray-400 font-light leading-relaxed">{{ sample.objective }}</p></div>
  {% endif %}
  {% if sample.skills_demonstrated %}
  <div>
    <p class="text-xs uppercase tracking-widest text-gray-600 mb-3">Skills Demonstrated</p>
    <ul class="space-y-3">
      {% for item in sample.skills_demonstrated %}
      <li class="flex gap-3 text-gray-400 font-light leading-relaxed"><span class="text-gray-700 flex-shrink-0">→</span><span>{{ item }}</span></li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}
  {% if sample.external_link %}
  <a href="{{ sample.external_link }}" class="inline-block text-xs uppercase tracking-widest border-b border-gray-700 pb-1 text-gray-300 hover:text-gold hover:border-gold transition">View Full Work →</a>
  {% endif %}
</section>

<footer class="max-w-screen-md mx-auto px-8 py-16 border-t border-gray-900 text-center">
  <a href="/writing-samples/" class="text-xs uppercase tracking-widest border-b border-gray-700 pb-1 text-gray-300 hover:text-gold hover:border-gold transition">← All Writing Samples</a>
</footer>

{% include "footer.njk" %}
{% include "analytics.njk" %}
{% include "motion.njk" %}
</body>
</html>

permalink: "/writing-samples/index.html"
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Writing Samples | Srijayee</title>
<link rel="canonical" href="https://ivygstyles.pages.dev{{ page.url }}">
<meta name="description" content="Representative writing samples across e-commerce, editorial, and SEO content.">
<meta property="og:title" content="Writing Samples | Srijayee">
<meta property="og:description" content="Representative writing samples across e-commerce, editorial, and SEO content.">
<meta property="og:type" content="website">
<meta name="twitter:card" content="summary_large_image">
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#000000; --paper-deep:#14110B;
    --ink:#D4AF37; --ink-soft:#A08847;
    --muted:#D6CBB0; --faint:#5C4F2E;
    --line:#2A2419; --brass:#F0C550;
  }

  body{font-family:'Inter',sans-serif;background-color:var(--paper);color:var(--ink);overflow-x:hidden;}
  .serif{font-family:'Playfair Display',serif;}
  a:focus-visible{outline:2px solid var(--ink);outline-offset:3px;}
</style>
</head>
<body class="antialiased selection:bg-[var(--line)] selection:text-[var(--ink)]">

{% set active = "writing-samples" %}
{% include "nav.njk" %}
{% set breadcrumbs = [{"label": "Home", "url": "/"}, {"label": "Writing Samples", "url": "/writing-samples/"}] %}
{% include "breadcrumbs.njk" %}

<header class="max-w-screen-xl mx-auto px-8 pt-8 pb-16 max-w-2xl">
  <p class="text-xs uppercase tracking-[0.2em] text-[var(--muted)] mb-6">Writing Samples</p>
  <h1 data-hero-reveal class="text-4xl md:text-6xl serif font-medium leading-tight text-[var(--ink)]">The range, in pieces.</h1>
</header>

<section class="max-w-screen-xl mx-auto px-8 pb-24">
  {% if collections.writingSamples.length %}
    {% for w in collections.writingSamples %}
    <a href="/writing-samples/{{ w.slug }}/" data-reveal class="group block border-t border-[var(--line)] py-10 {{ 'border-b' if loop.last }}">
      <p class="text-xs uppercase tracking-widest text-[var(--muted)] mb-2">{{ w.publication_type }}</p>
      <h2 class="text-2xl md:text-3xl serif text-[var(--ink-soft)] group-hover:text-[var(--brass)] group-hover:italic transition-all duration-500 mb-3 max-w-2xl">{{ w.title }}</h2>
      <p class="text-[var(--muted)] font-light leading-relaxed max-w-xl">{{ w.excerpt }}</p>
    </a>
    {% endfor %}
  {% else %}
    <div class="py-14 text-[var(--muted)] text-sm">Writing samples will appear here once published in the CMS.</div>
  {% endif %}
</section>

{% include "footer.njk" %}
{% include "animations.njk" %}
{% include "analytics.njk" %}
</body>
</html>

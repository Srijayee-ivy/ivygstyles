<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Media Kit | Srijayee</title>
<meta name="description" content="A short, shareable media kit for brands, agencies, and press.">
<meta property="og:title" content="Media Kit | Srijayee">
<meta property="og:description" content="A short, shareable media kit for brands, agencies, and press.">
<meta property="og:type" content="website">
<meta name="twitter:card" content="summary_large_image">
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet">
<style>
  body{font-family:'Inter',sans-serif;background-color:#000;color:#fff;overflow-x:hidden;}
  .serif{font-family:'Playfair Display',serif;}
  a:focus-visible,button:focus-visible{outline:2px solid #fff;outline-offset:3px;}
  @media(prefers-reduced-motion:reduce){ *{transition-duration:0.01ms !important;} }
  @media print {
    body{background:#fff !important;color:#000 !important;}
    nav, footer, .no-print{display:none !important;}
    h1,h2,.stat-value{color:#000 !important;}
    p,.stat-label{color:#333 !important;}
  }
</style>
</head>
<body class="antialiased selection:bg-gray-700 selection:text-white">

{% set active = "media-kit" %}
<div class="no-print">{% include "nav.njk" %}</div>

<header class="max-w-screen-xl mx-auto px-8 pt-12 pb-8 max-w-2xl">
  <p class="text-xs uppercase tracking-[0.2em] text-gray-500 mb-6">{{ mediaKit.eyebrow }}</p>
  <h1 class="text-4xl md:text-6xl serif font-medium leading-tight text-gray-200">{{ mediaKit.heading }}</h1>
  <p class="text-gray-400 font-light text-base md:text-lg mt-6 leading-relaxed max-w-xl">{{ mediaKit.subtext }}</p>
  <p class="no-print text-gray-600 text-xs mt-4">Tip: use your browser's Print → Save as PDF for a shareable file.</p>
</header>

<section class="max-w-screen-xl mx-auto px-8 py-12 grid sm:grid-cols-2 lg:grid-cols-4 gap-8 border-t border-gray-900">
  {% for stat in mediaKit.stats %}
  <div>
    <p class="stat-value text-3xl serif text-gray-100">{{ stat.value }}</p>
    <p class="stat-label text-xs uppercase tracking-widest text-gray-500 mt-2">{{ stat.label }}</p>
    <p class="text-gray-600 text-sm mt-1">{{ stat.detail }}</p>
  </div>
  {% endfor %}
</section>

<section class="max-w-screen-xl mx-auto px-8 py-12 border-t border-gray-900 grid md:grid-cols-12 gap-10">
  <div class="md:col-span-7">
    <p class="text-xs uppercase tracking-widest text-gray-600 mb-4">Bio</p>
    <p class="text-gray-300 font-light leading-relaxed">{{ mediaKit.bio }}</p>
  </div>
  <div class="md:col-span-5">
    <p class="text-xs uppercase tracking-widest text-gray-600 mb-4">Services</p>
    <p class="text-gray-300 font-light leading-relaxed">{{ mediaKit.services_summary }}</p>
    <p class="text-xs uppercase tracking-widest text-gray-600 mb-2 mt-8">Contact</p>
    <p class="text-gray-300 font-light">{{ social.contact_email }}</p>
    <a href="{{ social.portfolio_url }}" class="inline-block mt-4 text-xs uppercase tracking-widest border-b border-gray-700 pb-1 text-gray-300 hover:text-white hover:border-white transition">{{ mediaKit.portfolio_label }}</a>
  </div>
</section>

<footer class="no-print border-t border-gray-900 py-16">
  <div class="max-w-screen-2xl mx-auto px-8 text-center text-xs uppercase tracking-[0.15em] text-gray-600">
    <p>© 2026 Srijayee Ghosh. All rights reserved.</p>
  </div>
</footer>
{% include "analytics.njk" %}
</body>
</html>

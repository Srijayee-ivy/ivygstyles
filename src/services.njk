---
permalink: "/services.html"
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Services | Srijayee</title>
<meta name="description" content="Fashion & Luxury Content Strategy, Writing, and Personal Styling — process, pricing approach, and FAQs for each.">
<meta property="og:title" content="Services | Srijayee">
<meta property="og:description" content="Fashion & Luxury Content Strategy, Writing, and Personal Styling — process, pricing approach, and FAQs for each.">
<meta property="og:type" content="website">
<meta name="twitter:card" content="summary_large_image">
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet">
<style>
  body{font-family:'Inter',sans-serif;background-color:#000;color:#fff;overflow-x:hidden;}
  .serif{font-family:'Playfair Display',serif;}
  a:focus-visible,button:focus-visible{outline:2px solid #fff;outline-offset:3px;}
  summary::-webkit-details-marker{display:none;}
  summary::after{content:"+";color:#9ca3af;}
  details[open] summary::after{content:"–";}
</style>
</head>
<body class="antialiased selection:bg-gray-700 selection:text-white">

{% set active = "services" %}
{% include "nav.njk" %}

<header class="max-w-screen-xl mx-auto px-8 pt-12 pb-16 max-w-2xl">
  <p class="text-xs uppercase tracking-[0.2em] text-gray-500 mb-6">{{ services.eyebrow }}</p>
  <h1 class="text-4xl md:text-6xl serif font-medium leading-tight text-gray-200">{{ services.heading }}</h1>
  <p class="text-gray-400 font-light text-base md:text-lg mt-6 leading-relaxed max-w-xl">{{ services.subtext }}</p>
</header>

<section class="max-w-screen-xl mx-auto px-8 pb-24">
  {% for s in services.services %}
  <div class="border-t border-gray-900 py-16 {{ 'border-b' if loop.last }}">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-16">
      <div class="md:col-span-5">
        <span class="serif italic text-xl text-gray-600 block mb-4">{{ ["I.","II.","III."][loop.index0] }}</span>
        <h2 class="text-3xl md:text-4xl serif text-gray-200 mb-5">{{ s.name }}</h2>
        <p class="text-gray-500 font-light leading-relaxed mb-4">{{ s.summary }}</p>
        <p class="text-xs uppercase tracking-widest text-gray-600 mb-1">Ideal For</p>
        <p class="text-gray-500 font-light leading-relaxed text-sm mb-6">{{ s.ideal_for }}</p>
        <p class="text-xs uppercase tracking-widest text-gray-600 mb-1">Pricing</p>
        <p class="text-gray-500 font-light leading-relaxed text-sm">{{ s.pricing_note }}</p>
      </div>

      <div class="md:col-span-4">
        <p class="text-xs uppercase tracking-widest text-gray-600 mb-4">Process</p>
        <ol class="space-y-4">
          {% for step in s.process %}
          <li class="flex gap-3 text-sm text-gray-400 font-light leading-relaxed">
            <span class="serif italic text-gray-600 flex-shrink-0">{{ loop.index }}</span>
            <span>{{ step }}</span>
          </li>
          {% endfor %}
        </ol>
      </div>

      <div class="md:col-span-3">
        <p class="text-xs uppercase tracking-widest text-gray-600 mb-4">FAQ</p>
        {% for f in s.faq %}
        <details class="border-b border-gray-900 py-4 first:pt-0">
          <summary class="cursor-pointer flex justify-between items-start gap-2 text-sm text-gray-300">{{ f.question }}</summary>
          <p class="mt-2 text-gray-500 font-light text-sm leading-relaxed">{{ f.answer }}</p>
        </details>
        {% endfor %}
        <a href="/contact.html" class="inline-block mt-6 text-xs uppercase tracking-widest border-b border-gray-700 pb-1 text-gray-400 hover:text-white hover:border-white transition">Enquire →</a>
      </div>
    </div>
  </div>
  {% endfor %}

  <div class="mt-16 text-center">
    <a href="{{ services.closing_cta_href }}" class="inline-block border border-gray-700 px-10 py-5 text-xs uppercase tracking-widest text-gray-300 hover:bg-white hover:text-black hover:border-white transition-all duration-500">{{ services.closing_cta_label }}</a>
  </div>
</section>

{% include "footer.njk" %}
{% include "analytics.njk" %}
</body>
</html>

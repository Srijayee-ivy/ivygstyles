<!--
  Scroll-reveal motion system — powered by GSAP + ScrollTrigger (free CDN, no build step).
  Usage unchanged from before: class="reveal" fades an element up into view once,
  the first time it scrolls into the viewport. class="reveal-stagger" on a parent
  staggers its direct children in sequence. Respects prefers-reduced-motion.
-->
<style>
  .reveal, .reveal-stagger > * {
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal, .reveal-stagger > * {
      opacity: 1;
    }
  }
</style>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script>
  (function () {
    if (typeof gsap === "undefined") {
      // GSAP failed to load (offline/blocked) — fail gracefully, just show content.
      document.querySelectorAll(".reveal, .reveal-stagger > *").forEach(function (el) {
        el.style.opacity = 1;
      });
      return;
    }
    gsap.registerPlugin(ScrollTrigger);

    var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var EASE = "power2.out";
    var DURATION = reduceMotion ? 0 : 0.8;

    function revealOnce(el, opts) {
      gsap.fromTo(
        el,
        { opacity: 0, y: reduceMotion ? 0 : 28 },
        {
          opacity: 1,
          y: 0,
          duration: DURATION,
          ease: EASE,
          delay: (opts && opts.delay) || 0,
          scrollTrigger: {
            trigger: el,
            start: "top 88%",
            once: true
          }
        }
      );
    }

    // Plain .reveal elements (not inside a .reveal-stagger container)
    document.querySelectorAll(".reveal").forEach(function (el) {
      revealOnce(el);
    });

    // .reveal-stagger containers: animate direct children in sequence
    document.querySelectorAll(".reveal-stagger").forEach(function (group) {
      Array.from(group.children).forEach(function (child, i) {
        revealOnce(child, { delay: reduceMotion ? 0 : i * 0.09 });
      });
    });
  })();
</script>
